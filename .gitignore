# Dependencies
node_modules/
pnpm-lock.yaml
yarn.lock

# package-lock.json is intentionally committed: CI uses `npm ci`, which
# requires a lockfile, and without one dependency versions drift between runs.

# Build outputs
dist/
build/
*.tsbuildinfo

# Development
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Environment
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Testing
coverage/
.nyc_output/

# Misc
.turbo/

# Scratch probes. A throwaway file under test/ is picked up by the
# non-recursive test glob and by tsc, so one left behind fails CI — and it
# runs in everybody's suite until somebody notices. Name a throwaway with
# one of these and it cannot be committed by accident.
*.tmp.ts
zprobe*.test.ts

# Scratch for one dev-loop round — captured screenshots, intermediate harness
# output, the verdict being acted on. Nothing in here is an artifact: a
# screenshot that belongs to the change goes through the graphics gates into
# docs/screenshots/, and a scenario worth keeping goes in
# tools/echo-sim/scenarios/ beside its expected output.
.dev-loop/
