{
  "name": "@echoes/backend",
  "version": "0.0.1",
  "description": "Echoes of the Abyss - Game server",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "bench": "node --import tsx bench/echo-pass.mjs",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@colyseus/core": "^0.15.57",
    "@colyseus/schema": "^2.0.0",
    "@colyseus/ws-transport": "^0.15.3",
    "@echoes/shared": "*",
    "bitecs": "^0.3.40",
    "colyseus": "^0.15.11",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.19.0",
    "eslint": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
