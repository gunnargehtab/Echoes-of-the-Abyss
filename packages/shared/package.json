{
  "name": "@echoes/shared",
  "version": "0.0.1",
  "description": "Echoes of the Abyss - shared simulation rules, constants and Echo Layer math",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test \"test/*.test.ts\"",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
