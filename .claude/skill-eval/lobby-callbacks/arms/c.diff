+  onChange(handler: () => void): () => void {
+    this.changeHandlers.push(handler);
+    return () => {
+      const at = this.changeHandlers.indexOf(handler);
+      if (at >= 0) this.changeHandlers.splice(at, 1);
+    };
+  }
