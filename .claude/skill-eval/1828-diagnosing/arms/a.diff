@@ -0,0 +1,96 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdirSync, mkdtempSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { dirname, join } from 'node:path';
+
+import { checkDependencies, satisfies } from '../preflight-deps.mjs';
+
+function write(path, json) {
+  mkdirSync(dirname(path), { recursive: true });
+  writeFileSync(path, JSON.stringify(json));
+}
+
+/** A root that pins `three` for its tools, and a frontend that asks a newer one. */
+function fixture({ nested }) {
+  const repo = mkdtempSync(join(tmpdir(), 'preflight-'));
+  write(join(repo, 'package.json'), {
+    name: 'root',
+    workspaces: ['packages/frontend'],
+    devDependencies: { three: '0.169.0' },
+  });
+  write(join(repo, 'node_modules/three/package.json'), { name: 'three', version: '0.169.0' });
+  write(join(repo, 'packages/frontend/package.json'), {
+    name: '@echoes/frontend',
+    dependencies: { three: '^0.187.0' },
+  });
+  if (nested) {
+    write(join(repo, 'packages/frontend/node_modules/three/package.json'), {
+      name: 'three',
+      version: '0.187.0',
+    });
+  }
+  return repo;
+}
+
+test('a workspace that falls through to the root pin is out of range (#1828)', (t) => {
+  const repo = fixture({ nested: false });
+  t.after(() => rmSync(repo, { recursive: true, force: true }));
+  const { missing, outOfRange } = checkDependencies(repo);
+  assert.deepEqual(missing, []);
+  assert.equal(outOfRange.length, 1);
+  assert.match(outOfRange[0], /^three {2}\(@echoes\/frontend asks \^0\.187\.0, resolves 0\.169\.0/);
+});
+
+test('the nested copy put back passes, and the root keeps its own pin', (t) => {
+  const repo = fixture({ nested: true });
+  t.after(() => rmSync(repo, { recursive: true, force: true }));
+  assert.deepEqual(checkDependencies(repo), { missing: [], outOfRange: [] });
+});
+
+test('a dependency resolved nowhere is missing, not out of range', (t) => {
+  const repo = fixture({ nested: true });
+  t.after(() => rmSync(repo, { recursive: true, force: true }));
+  rmSync(join(repo, 'node_modules/three'), { recursive: true });
+  assert.deepEqual(checkDependencies(repo), { missing: ['three  (root)'], outOfRange: [] });
+});
+
+test('caret ranges follow npm, including the 0.x rule', () => {
+  assert.equal(satisfies('0.187.3', '^0.187.0'), true);
+  assert.equal(satisfies('0.169.0', '^0.187.0'), false);
+  assert.equal(satisfies('0.188.0', '^0.187.0'), false);
+  assert.equal(satisfies('8.9.0', '^8.0.0'), true);
+  assert.equal(satisfies('9.0.0', '^8.0.0'), false);
+  assert.equal(satisfies('0.0.4', '^0.0.3'), false);
+  assert.equal(satisfies('1.9.9', '^1.x'), true);
+});
+
+test('exact, tilde, x-ranges, comparators and alternatives', () => {
+  assert.equal(satisfies('0.169.0', '0.169.0'), true);
+  assert.equal(satisfies('0.169.1', '0.169.0'), false);
+  assert.equal(satisfies('1.2.9', '~1.2.3'), true);
+  assert.equal(satisfies('1.3.0', '~1.2.3'), false);
+  assert.equal(satisfies('5.4.0', '*'), true);
+  assert.equal(satisfies('1.2.7', '1.2.x'), true);
+  assert.equal(satisfies('1.3.0', '1.2'), false);
+  assert.equal(satisfies('1.5.0', '>=1.2 <2'), true);
+  assert.equal(satisfies('2.0.0', '>=1.2 <2'), false);
+  assert.equal(satisfies('1.3.0', '>1.2'), true);
+  assert.equal(satisfies('1.2.5', '>1.2'), false);
+  assert.equal(satisfies('3.1.0', '^1.0.0 || ^3.0.0'), true);
+  assert.equal(satisfies('2.1.0', '^1.0.0 || ^3.0.0'), false);
+});
+
+test('a prerelease satisfies only a range that names its own tuple', () => {
+  assert.equal(satisfies('2.0.0-beta.1', '^1.0.0'), false);
+  assert.equal(satisfies('1.5.0-rc.1', '^1.0.0'), false);
+  assert.equal(satisfies('1.0.0-rc.2', '^1.0.0-rc.1'), true);
+  assert.equal(satisfies('1.0.0-rc.1', '^1.0.0-rc.2'), false);
+});
+
+test('a spec the subset cannot read is unknown, so only presence is checked', () => {
+  assert.equal(satisfies('1.0.0', 'latest'), null);
+  assert.equal(satisfies('1.0.0', 'file:../shared'), null);
+  assert.equal(satisfies('1.0.0', '1.0.0 - 2.0.0'), null);
+  assert.equal(satisfies('not-a-version', '^1.0.0'), null);
+});
